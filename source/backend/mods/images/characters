function onCreate()
    -- Initialize Grey's base sprite sheet and XML configurations
    makeAnimatedLuaSprite('greyImpostor', 'characters/Grey_Assets', 250, 400);
    
    -- Register frame animations mapped to the XML texture atlas
    addAnimationByPrefix('greyImpostor', 'idle', 'Grey Idle', 24, true);
    addAnimationByPrefix('greyImpostor', 'singLEFT', 'Grey Left Note', 24, false);
    addAnimationByPrefix('greyImpostor', 'singDOWN', 'Grey Down Note', 24, false);
    addAnimationByPrefix('greyImpostor', 'singUP', 'Grey Up Note', 24, false);
    addAnimationByPrefix('greyImpostor', 'singRIGHT', 'Grey Right Note', 24, false);
    
    -- Render asset safely behind standard user interface layers
    addLuaSprite('greyImpostor', false);
    playAnim('greyImpostor', 'idle', true);
end

-- Force animation sync directly on corresponding beat hits
function onBeatHit()
    if curBeat % 2 == 0 and getProperty('greyImpostor.animation.curAnim.name') == 'idle' then
        objectPlayAnimation('greyImpostor', 'idle', true);
    end
end


